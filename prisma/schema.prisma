generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Cliente {
  id            Int        @id @default(autoincrement())
  nombre        String
  apellido      String
  telefono      String
  correo        String?
  fechaRegistro DateTime   @default(now())
  vehiculos     Vehiculo[]
}

model Vehiculo {
  id            Int        @id @default(autoincrement())
  clienteId     Int
  placa         String     @unique
  marca         String
  modelo        String
  anio          Int?
  color         String?
  fechaRegistro DateTime   @default(now()) @map("fecha_registro")
  cliente       Cliente    @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  pedidos       Pedido[]
  servicios     Servicio[]
}

model Usuario {
  id            Int      @id @default(autoincrement())
  nombre        String
  correo        String   @unique
  passwordHash  String   @map("password_hash")
  rol           String   @default("administrador")
  fechaRegistro DateTime @default(now()) @map("fecha_registro")

  @@map("usuarios")
}

model Servicio {
  id          Int      @id @default(autoincrement())
  vehiculoId  Int      @map("vehiculo_id")
  fecha       DateTime
  descripcion String
  costo       Float
  vehiculo    Vehiculo @relation(fields: [vehiculoId], references: [id], onDelete: Restrict)

  @@map("servicios")
}

model Pedido {
  id               Int       @id @default(autoincrement())
  vehiculoId       Int       @map("vehiculo_id")
  descripcion      String
  estado           String    @default("pendiente")
  fechaCreacion    DateTime  @default(now()) @map("fecha_creacion")
  fechaTerminacion DateTime? @map("fecha_terminacion")
  vehiculo         Vehiculo  @relation(fields: [vehiculoId], references: [id], onDelete: Restrict)

  @@map("pedidos")
}
