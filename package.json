{
  "name": "mini-open-garage-flow",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "format": "prettier --write package.json vitest.config.mts commitlint.config.mjs .lintstagedrc.json",
    "format:check": "prettier --check package.json vitest.config.mts commitlint.config.mjs .lintstagedrc.json",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "prepare": "husky",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.2.0",
    "dotenv": "^17.2.3",
    "jose": "^6.2.15",
    "lucide-react": "^1.69.0",
    "next": "^16.4.5",
    "prisma": "^7.10.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.23.15",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.4.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
